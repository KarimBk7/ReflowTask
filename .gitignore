# ─── Java ────────────────────────────────────────────────────────────────────
*.class
*.log
*.ctxt
.mtj.tmp/

# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# ...but the Maven/Gradle wrappers must be committed so a clone can build
!.mvn/wrapper/maven-wrapper.jar
!gradle/wrapper/gradle-wrapper.jar

# JVM crash logs
hs_err_pid*
replay_pid*

# ─── Build output ────────────────────────────────────────────────────────────
target/
build/
out/
bin/
!src/**/bin/
.gradle/

# ─── Node / React frontend ───────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
.vite/
coverage/
*.tsbuildinfo
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Secrets & local config ──────────────────────────────────────────────────
# Commit .env.example instead; never the real values.
.env
.env.*
!.env.example
*.local
application-local.properties
application-local.yml
application-secrets.properties

# ─── Data / runtime ──────────────────────────────────────────────────────────
# H2 dev database files and Docker volume mounts.
# Unanchored so they match at any depth — H2 writes to backend/data/, not ./data/.
*.db
*.mv.db
*.trace.db
data/
pgdata/

# ─── IDE ─────────────────────────────────────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.classpath
.project
.settings/
.factorypath

# ─── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# ─── Agent tooling ───────────────────────────────────────────────────────────
# Vendored skill content stays out of the repo — skills-lock.json is committed
# and pins it, so it can be restored on a clone.
.agents/
.claude/
.grok/
!skills-lock.json

# Impeccable design artifacts (PRODUCT.md, DESIGN.md, design.json, surface briefs and
# config.json) are project truth and committed. Everything below is per-session working
# state: decision-page servers, screenshots, build gates and generated mocks.
.impeccable/config.local.json
.impeccable/live/
.impeccable/questions/
.impeccable/review/
.impeccable/build/
.impeccable/mocks/

# Playwright MCP session snapshots and console logs.
.playwright-mcp/
