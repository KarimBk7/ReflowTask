# Copy this file to .env and fill in a real password before running `docker compose up`.
# .env itself is gitignored, so the real password never ends up in the repository.

POSTGRES_PASSWORD=change-me

# The scheduler works in wall-clock time, so this should be the timezone the working hours are
# actually set in. Defaults to Europe/Berlin if left unset.
TZ=Europe/Berlin

# Optional: the password of the first admin account. Without it, a fresh install starts with the
# admin password "changeme" and makes you choose a new one at first login. Set this (8+
# characters) when the server is reachable by others before you get to log in.
# REFLOWTASK_INITIAL_ADMIN_PASSWORD=
